# Copy to `.env.local` (git-ignored) and fill in your key, or export the variable in your shell.
# `just dev`, `pnpm dev`, `pnpm start` and `pnpm eval` all read it.
OPENAI_API_KEY=

# Public mode ignores the server key and requires a visitor key for model work.
PUBLIC_DEMO=false
# Number of trusted proxy entries counted from the right of X-Forwarded-For; 0 ignores it.
TRUSTED_PROXY_HOPS=1
# Keep reset disabled on shared public deployments.
ALLOW_DEMO_RESET=false

# Optional overrides
OPENAI_MODEL=gpt-4.1
OPENAI_GUARDRAIL_MODEL=gpt-6-luna
REFUND_APPROVAL_THRESHOLD=500
# Optional extra password in public mode (signed cookies still scope every request).
# Local mode is staff-wide: set this before sharing it.
ADMIN_PASSWORD=
# Signs the per-conversation cookies (HMAC). The built-in dev default is PUBLIC: set your own value
# (any long random string, e.g. `openssl rand -base64 32`) for anything reachable by other people.
SESSION_SECRET=
# Also protects the Agent View inspector feed (/api/admin/inspector) and POST /api/reset when set.
# ALLOW_DEMO_RESET=true enables the reset button on a production build (local demo only).

# Optional build-time developer feedback overlay. Default false; URL ?annotate=1 also opts in.
NEXT_PUBLIC_DEV_ANNOTATIONS=false
